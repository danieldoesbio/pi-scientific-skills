From 1260d2bca4aeac7bb3a290e2907ad4b190460f55 Mon Sep 17 00:00:00 2001
From: danieldoesbio <danieldoesbio@users.noreply.github.com>
Date: Tue, 8 Sep 2026 11:45:55 -0700
Subject: [PATCH] fix(coding-agent): report unknown /skill: names instead of
 forwarding them silently

_expandSkillCommand returned the input unchanged when the name did not
match a loaded skill, so "/skill:typo" (or a skill removed by a package
filter) reached the model as a literal user message with no diagnostic.
Emit a skill_expansion error on the miss, the same channel the existing
read-failure branch uses, so the TUI shows the miss. The text is still
forwarded, as before.
---
 .../coding-agent/src/core/agent-session.ts    | 12 +++++++--
 .../test/suite/agent-session-prompt.test.ts   | 25 ++++++++++++++++++-
 2 files changed, 34 insertions(+), 3 deletions(-)

diff --git a/packages/coding-agent/src/core/agent-session.ts b/packages/coding-agent/src/core/agent-session.ts
index f334354..4be8de8 100644
--- a/packages/coding-agent/src/core/agent-session.ts
+++ b/packages/coding-agent/src/core/agent-session.ts
@@ -1361,7 +1361,7 @@ export class AgentSession {
 	/**
 	 * Expand skill commands (/skill:name args) to their full content.
 	 * Returns the expanded text, or the original text if not a skill command or skill not found.
-	 * Emits errors via extension runner if file read fails.
+	 * Emits errors via extension runner if the skill is unknown or the file read fails.
 	 */
 	private _expandSkillCommand(text: string): string {
 		if (!text.startsWith("/skill:")) return text;
@@ -1371,7 +1371,15 @@ export class AgentSession {
 		const args = spaceIndex === -1 ? "" : text.slice(spaceIndex + 1).trim();
 
 		const skill = this.resourceLoader.getSkills().skills.find((s) => s.name === skillName);
-		if (!skill) return text; // Unknown skill, pass through
+		if (!skill) {
+			// Surface the miss like a read failure instead of silently sending "/skill:name" to the model
+			this._extensionRunner.emitError({
+				extensionPath: `skill:${skillName}`,
+				event: "skill_expansion",
+				error: `Unknown skill: ${skillName}`,
+			});
+			return text;
+		}
 
 		try {
 			const content = readFileSync(skill.filePath, "utf-8");
diff --git a/packages/coding-agent/test/suite/agent-session-prompt.test.ts b/packages/coding-agent/test/suite/agent-session-prompt.test.ts
index 1fa23fb..3d5e827 100644
--- a/packages/coding-agent/test/suite/agent-session-prompt.test.ts
+++ b/packages/coding-agent/test/suite/agent-session-prompt.test.ts
@@ -5,7 +5,7 @@ import type { AgentTool } from "@earendil-works/pi-agent-core";
 import { fauxAssistantMessage, fauxToolCall, type Model } from "@earendil-works/pi-ai";
 import { Type } from "typebox";
 import { afterEach, describe, expect, it } from "vitest";
-import type { ExtensionAPI, InputEvent } from "../../src/core/extensions/index.ts";
+import type { ExtensionAPI, ExtensionError, InputEvent } from "../../src/core/extensions/index.ts";
 import type { PromptTemplate } from "../../src/core/prompt-templates.ts";
 import { createSyntheticSourceInfo } from "../../src/core/source-info.ts";
 import { createTestResourceLoader } from "../utilities.ts";
@@ -191,6 +191,29 @@ describe("AgentSession prompt characterization", () => {
 		expect(expandedPrompt).toContain("explain this");
 	});
 
+	it("reports an unknown skill name instead of silently forwarding it", async () => {
+		const harness = await createHarness();
+		harnesses.push(harness);
+		const errors: ExtensionError[] = [];
+		await harness.session.bindExtensions({ onError: (error) => errors.push(error) });
+		let sentPrompt = "";
+
+		harness.setResponses([
+			(context) => {
+				const user = context.messages.find((message) => message.role === "user");
+				sentPrompt = user ? getMessageText(user) : "";
+				return fauxAssistantMessage("ok");
+			},
+		]);
+
+		await harness.session.prompt("/skill:does-not-exist explain this");
+
+		expect(errors).toEqual([
+			{ extensionPath: "skill:does-not-exist", event: "skill_expansion", error: "Unknown skill: does-not-exist" },
+		]);
+		expect(sentPrompt).toBe("/skill:does-not-exist explain this");
+	});
+
 	it("expands prompt templates before sending the prompt", async () => {
 		const template: PromptTemplate = {
 			name: "review",
